# Copy this file to .env and fill in real values. .env is gitignored.
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-bytes
DB_PASSWORD=example_password

# Only needed on the EC2 server, to run docker-compose.prod.yml.
# The CI/CD pipeline generates this file automatically from GitHub Secrets
# and copies it to the server on every deploy — you don't need to create
# this part by hand, it's just documented here for reference.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest
